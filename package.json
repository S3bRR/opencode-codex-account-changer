{
  "name": "opencode-codex-account-changer",
  "version": "1.0.0",
  "description": "Safe multi-account switching for OpenCode ChatGPT OAuth",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "bun test",
    "verify": "npm run check && npm test && npm run build && bun scripts/verify-package.ts"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.25 <1.19.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.25"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.25",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^24.3.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/S3bRR/opencode-codex-account-changer.git"
  },
  "keywords": [
    "opencode",
    "chatgpt",
    "oauth",
    "codex"
  ]
}
